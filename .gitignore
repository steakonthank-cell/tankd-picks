# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
.streamlit/secrets.toml
.env
*.key
*.pem

# ── Runtime caches ────────────────────────────────────────────────────────────
prizepicks_cache/
fanduel_cache/
pickfinder_cache/
moneylines_cache/
data/espn_odds_cache.json

# ── Scanner output (regenerated at runtime) ───────────────────────────────────
output/

# ── Raw data (too large) ──────────────────────────────────────────────────────
data/tennis/raw/
data/nba/raw/
data/mlb/raw/
data/wnba/raw/

# ── NBA training data (464MB — too large for GitHub) ─────────────────────────
data/nba/processed/

# ── Model files — committed so Streamlit Cloud can run AI scanners ────────────
# (all individual files are <5MB, total ~178MB)

# ── Large tennis training CSV (1.5GB) — player_cache.parquet is used instead ─
data/tennis/processed/training_dataset.csv

# ── MLB backtest/analysis outputs (regenerated by scripts, too large/noisy) ──
data/mlb/boxscores/
data/mlb/processed/*.csv
!data/mlb/processed/batter_training.csv
!data/mlb/processed/pitcher_training.csv
sim_backtest_calibration_games.csv
sim_backtest_calibration_summary.txt

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
backfill_fetch.log

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# frontend/dist/ is not a build output despite the name — app.jsx is
# hand-written source loaded directly via Babel Standalone (see
# frontend/dist/index.html). Track it; keep the many local .bak* snapshots
# in that directory (and index.html, for now) ignored.
!frontend/dist/
frontend/dist/*
!frontend/dist/app.jsx

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Claude ───────────────────────────────────────────────────────────────────
.claude/
